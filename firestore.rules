rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'chendoc100@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Per-user draw progress (unchanged path, so existing cloud progress carries over)
    match /progress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Personal answer edits, notes, saved microscope views
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /images/{imageId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['slide', 'data', 'w', 'h', 'at'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
      }
    }

    // Master slide list: every signed-in user can read, only the admin can write
    match /content/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Error reports: anyone signed in may file one as themselves; only the admin reads them
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['slide', 'text', 'uid', 'name', 'at', 'done'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1500
        && request.resource.data.done == false;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only: admin-tab check and the admin's own microteaching links
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid));
    }

    // Captured slide-field images: only classmates the admin approved
    match /fimg/{imageId} {
      allow read: if isAdmin() || approved();
      allow write: if isAdmin();
    }

    // Approved viewers (the admin manages; each person may check their own entry)
    match /access/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Requests to see slide images
    match /requests/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email;
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
